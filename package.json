{
  "name": "opencode-mailbox",
  "version": "0.1.0",
  "description": "A per-project mailbox for OpenCode sessions — detect OPEN handoff messages on idle, prompt the agent to handle them, with loop guards",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-wolf-rsh/opencode-mailbox.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "opencode",
    "plugin",
    "mailbox",
    "handoff",
    "agent",
    "automation"
  ],
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.0.0",
    "@opencode-ai/sdk": ">=1.0.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@opencode-ai/sdk": "^1.18.18",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
